# ==============================================================================
# Student Management System - Environment Configuration Template
# Copy this file to .env and configure strong credentials for production
# ==============================================================================

# MySQL Container Initialization Variables
MYSQL_DATABASE=student_db
MYSQL_USER=student_user
MYSQL_PASSWORD=change_this_student_db_password
MYSQL_ROOT_PASSWORD=change_this_root_secure_password

# Spring Boot Database Connection Variables
DB_HOST=mysql
DB_PORT=3306
DB_NAME=student_db
DB_USERNAME=student_user
DB_PASSWORD=change_this_student_db_password

# Application Settings
CORS_ALLOWED_ORIGINS=*
PORT=80
